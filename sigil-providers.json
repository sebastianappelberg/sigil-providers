{
  "schemaVersion": 1,
  "providers": [
    {
      "type": "url",
      "id": "github-search",
      "name": "GitHub Search",
      "version": "1.0.4",
      "description": "Search GitHub repositories, code, and issues",
      "sourceUrl": "https://github.com/sebastianappelberg/sigil-providers/blob/master/sigil-providers.json#L4-L19",
      "urlTemplate": "https://github.com/search?q={query}",
      "aliases": [
        "github",
        "gh"
      ],
      "icon": "simple:github",
      "voiceEnabled": true,
      "titleTemplate": "Search GitHub for \"{query}\""
    },
    {
      "type": "script",
      "id": "obsidian",
      "name": "Obsidian",
      "version": "1.0.0",
      "description": "Search and open notes from local Obsidian vaults",
      "sourceUrl": "https://github.com/sebastianappelberg/sigil-providers/tree/main",
      "files": [
        "obsidian-provider.js"
      ],
      "commands": {
        "search": {
          "command": "node",
          "args": [
            "{providerDir}/obsidian-provider.js",
            "search",
            "{query}"
          ],
          "timeoutMs": 5000
        },
        "open": {
          "command": "node",
          "args": [
            "{providerDir}/obsidian-provider.js",
            "open"
          ],
          "timeoutMs": 5000
        }
      },
      "aliases": [
        "obsidian",
        "vault"
      ]
    }
  ]
}
